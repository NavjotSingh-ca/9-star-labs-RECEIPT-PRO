{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group Radix UI packages",
      "matchPackagePrefixes": ["@radix-ui/"],
      "groupName": "Radix UI"
    },
    {
      "description": "Group Storybook packages",
      "matchPackagePrefixes": ["@storybook/"],
      "groupName": "Storybook"
    },
    {
      "description": "Group Supabase packages",
      "matchPackagePrefixes": ["@supabase/"],
      "groupName": "Supabase"
    },
    {
      "description": "Group Stripe packages",
      "matchPackagePrefixes": ["@stripe/", "stripe"],
      "groupName": "Stripe"
    },
    {
      "description": "Group TanStack packages",
      "matchPackagePrefixes": ["@tanstack/"],
      "groupName": "TanStack"
    },
    {
      "description": "Group ESLint packages",
      "matchPackagePrefixes": ["eslint"],
      "groupName": "ESLint"
    },
    {
      "description": "Auto-merge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Major updates get manual review",
      "matchUpdateTypes": ["major"],
      "labels": ["major", "dependencies"],
      "reviewers": ["navjo"]
    },
    {
      "description": "Pin devDependencies",
      "matchDepTypes": ["devDependencies"],
      "groupName": "devDependencies",
      "rangeStrategy": "pin"
    },
    {
      "description": "Next.js ecosystem",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "Next.js",
      "labels": ["framework", "dependencies"]
    }
  ],
  "schedule": ["before 9am on Monday"],
  "timezone": "America/Edmonton",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
