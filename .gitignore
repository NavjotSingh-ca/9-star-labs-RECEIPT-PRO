# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# superpowers brainstorming mockups
.superpowers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# testing
playwright-report/
test-results/

# storybook
storybook-static/

# local dev-server process/log artifacts
.dev-server*
.dev-server-*.log

# agent/tooling coordination scratch files (not app source)
.agent-coordination/
.opencode/

# typescript
*.tsbuildinfo
next-env.d.ts

nul

