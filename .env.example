# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Receipt Extraction (required for scanning)
GOOGLE_AI_KEY=your-google-ai-key

# Stripe (optional - for billing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (optional - for email notifications)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# CRA Digest (optional - for daily missing-receipts report)
CRON_SECRET=your-cron-secret

# QuickBooks Online (optional - for accounting sync)
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret

# Token Encryption (REQUIRED in production - AES-256-GCM key for QBO/Xero tokens)
# Generate with: openssl rand -hex 32
# WARNING: Without this, the app will THROW in production.
TOKEN_ENCRYPTION_KEY=hex-64-char-key

# Site URL (CRITICAL for OAuth redirects — set this to your production domain).
# Google OAuth and password-reset redirects use this value.
# For local dev, keep as http://localhost:3000
# For production, set to https://yourdomain.com AND add it to Supabase Auth → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional - error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
# Org/project slugs used by @sentry/nextjs at build time for source map uploads
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# PostHog (optional - product analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe Price IDs (optional - for checkout links)
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_pro_xxx
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=price_business_xxx

# Audit HMAC Secret (optional - for tamper-evident audit log chain)
AUDIT_HMAC_SECRET=your-hmac-secret

# Upstash Redis (optional - for distributed rate limiting)
UPSTASH_REDIS_URL=https://your-region.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token
